# Zero Phishing AI Backend Configuration
# Copy to .env and fill in values

# Application
APP_NAME="Zero Phishing AI"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=1

# Database
# For local development (outside Docker): use localhost
# For Docker: docker-compose.yml overrides with service names (postgres:5432, redis:6379)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/zerophish
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (for caching, rate limiting)
# For local development: localhost
# For Docker: docker-compose.yml overrides with redis:6379
REDIS_URL=redis://localhost:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8080/auth/microsoft/callback

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Safe Browsing API
SAFE_BROWSING_API_KEY=your-safe-browsing-api-key

# PhishTank
PHISHTANK_API_KEY=your-phishtank-api-key
PHISHTANK_DATA_URL=https://data.phishtank.com/data/online-valid.csv

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# User hashing (for stable user IDs)
USER_HASH_SECRET=your-user-hash-secret-change-in-production

# Domain reputation
BRAND_LIST_PATH=./data/brands.json
WHOIS_CACHE_TTL_HOURS=24

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600

# CORS
CORS_ORIGINS=["chrome-extension://*"]

# OpenTelemetry
# For local development: localhost
# For Docker: use jaeger/otel collector service name if available
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=zero-phishing-backend